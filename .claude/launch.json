{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export NVM_DIR=$HOME/.nvm; . $NVM_DIR/nvm.sh; cd frontend && npm run dev"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && exec .venv/bin/uvicorn app.main:app --reload --port 8000"
      ],
      "port": 8000
    }
  ]
}